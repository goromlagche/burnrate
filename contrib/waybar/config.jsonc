// Add to your Waybar config, then put "custom/claude", "custom/codex" and "custom/opencode" in a modules list.
{
  "custom/claude": {
    "exec": "cat ~/.cache/burnrate/claude.json",
    "return-type": "json",
    "interval": 10,
    "on-click": "systemctl --user start burnrate.service"
  },
  "custom/codex": {
    "exec": "cat ~/.cache/burnrate/codex.json",
    "return-type": "json",
    "interval": 10,
    "on-click": "systemctl --user start burnrate.service"
  },
  // Only with OpenCode V2 installed; burnrate skips it otherwise.
  "custom/opencode": {
    "exec": "cat ~/.cache/burnrate/opencode.json",
    "return-type": "json",
    "interval": 10,
    "on-click": "systemctl --user start burnrate.service"
  }
}
